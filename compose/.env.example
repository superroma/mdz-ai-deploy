# --- site identity ---
# For local testing without a real domain/TLS, set SITE_DOMAIN=:80
SITE_DOMAIN=mysite.example.com
# MDZ_REF can be a branch, tag, or commit SHA. Pin to a SHA/tag for reproducible builds.
MDZ_REF=main

# --- content repo ---
# CONTENT_REPO is consumed by the control-plane spawn-site skill (Phase 3) to
# clone into the shared volume; the compose stack itself expects /data/repo to
# already be populated.
CONTENT_REPO=git@github.com:superroma/bridge-home.git
SYNC_BRANCH=main

# --- sync sidecar ---
SYNC_BOT_NAME=mdz-bot
SYNC_BOT_EMAIL=bot@mdz.local
# SYNC_DEBOUNCE_MS / SYNC_POLL_MS must be positive integers (milliseconds).
SYNC_DEBOUNCE_MS=5000
SYNC_POLL_MS=45000
# Comma-separated gitignore-style paths never committed. Covers the future
# relocated auth-state (.auth/) AND current MDZ's secret path (pages/.settings/,
# matched by .settings/) so member emails are never pushed to the remote.
SYNC_EXCLUDE=.auth/,.settings/

# --- MDZ ---
JWT_SECRET=change-me
# PAGES_ROOT = /data/repo/${PAGES_SUBDIR}
PAGES_SUBDIR=pages

# Path on the host to the per-site deploy key (read-only mount into the sidecar)
DEPLOY_KEY=./secrets/deploy_key
